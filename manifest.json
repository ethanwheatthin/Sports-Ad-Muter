{
  "manifest_version": 3,
  "name": "Football Ad Muter",
  "version": "1.0.0",
  "description": "Automatically mutes ads during football streams by detecting active gameplay",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:*/*",
    "https://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["request-queue.js", "adaptive-sampler.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/logo/icon16.png",
      "32": "images/logo/icon32.png",
      "48": "images/logo/icon48.png",
      "128": "images/logo/icon128.png"
    }
  },
  "icons": {
    "16": "images/logo/icon16.png",
    "32": "images/logo/icon32.png",
    "48": "images/logo/icon48.png",
    "128": "images/logo/icon128.png"
  }
}