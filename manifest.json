{
  "manifest_version": 3,
  "name": "S.A.M (Sports Ad Muter)",
  "version": "1.0.0",
  "description": "Automatically mutes ads during live sports streams by detecting active gameplay",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["request-queue.js", "adaptive-sampler.js", "drm-signals.js", "content.js", "fab.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/logo/icon16.png",
      "32": "images/logo/icon32.png",
      "48": "images/logo/icon48.png",
      "128": "images/logo/icon128.png"
    }
  },
  "icons": {
    "16": "images/logo/icon16.png",
    "32": "images/logo/icon32.png",
    "48": "images/logo/icon48.png",
    "128": "images/logo/icon128.png"
  }
}